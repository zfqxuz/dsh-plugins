{
  "schemaVersion": 1,
  "name": "dsh-plugins",
  "description": "Discoverable DSH (DeepSeek Harness) plugins: installable as profile bundles or as home-level local plugins.",
  "homepage": "https://github.com/zfqxuz/dsh-plugins",
  "updatedAt": "2026-10-09",
  "install": {
    "list": "./install.sh list",
    "homeLevel": "DSH_HOME=~/.dsh ./install.sh <id>",
    "bundle": "dsh plugin --profile web add <repo>/<dir>",
    "bundleFromGit": "dsh plugin --profile web add github:zfqxuz/dsh-plugins#path:/<dir>"
  },
  "plugins": [
    {
      "id": "context-handoff",
      "package": "dsh-context-handoff",
      "dir": "context-handoff",
      "version": "1.2.0",
      "description": "可用上下文不足阈值时，先广播会话迁移契约（有消费者则由消费者接手创建新会话），无人认领才自建并携带 recall 摘要继续。",
      "descriptionEn": "On low available context, broadcasts a session-transfer request; a willing consumer creates and owns the continuation, otherwise the plugin creates one with a recall digest.",
      "tags": [
        "compaction",
        "context",
        "handoff",
        "ownership",
        "session",
        "session-transfer",
        "workspace"
      ],
      "entry": "context-handoff/index.js",
      "mount": {
        "id": "context-handoff",
        "name": "./plugins/dsh-context-handoff/index.js"
      },
      "defaultConfig": {
        "availableRatio": 0.5,
        "autoContinue": true,
        "continueMode": "fresh",
        "digestMaxChars": 12000,
        "claimWindowMs": 2000,
        "claimCommitMs": 15000,
        "requireConsumer": false,
        "excludePresets": [],
        "stateFile": ""
      },
      "tools": [
        "context_handoff"
      ],
      "commands": [
        "handoff"
      ],
      "test": "node context-handoff/test/mock.test.mjs && node context-handoff/test/transfer.test.mjs && node context-handoff/test/client.test.mjs"
    },
    {
      "id": "session-reader",
      "package": "dsh-session-reader",
      "dir": "session-reader",
      "version": "1.0.0",
      "description": "通过 session_id 读取另一个会话的完整转录（支持多帧 Zstandard 日志），注册 session_read 工具。",
      "descriptionEn": "Read another conversation transcript by session id (multi-frame Zstandard logs); registers the session_read tool.",
      "tags": [
        "session",
        "transcript",
        "recall",
        "zstd"
      ],
      "entry": "session-reader/index.js",
      "mount": {
        "id": "session-reader",
        "name": "./plugins/dsh-session-reader/index.js"
      },
      "defaultConfig": {},
      "tools": [
        "session_read"
      ],
      "commands": [],
      "test": null
    },
    {
      "id": "ecs-n8n-gh",
      "package": "dsh-ecs-n8n-gh",
      "dir": "ecs-n8n-gh",
      "version": "1.0.0",
      "description": "把 ECS SSH、n8n 工作流部署、GitHub Actions 查询注册为模型工具。",
      "descriptionEn": "Common ECS SSH, n8n workflow, and GitHub Actions operations as model-facing tools.",
      "tags": [
        "ecs",
        "ssh",
        "n8n",
        "github-actions",
        "deploy"
      ],
      "entry": "ecs-n8n-gh/index.js",
      "mount": {
        "id": "ecs-n8n-gh",
        "name": "./plugins/dsh-ecs-n8n-gh/index.js"
      },
      "defaultConfig": {
        "ecsHost": "",
        "ecsUser": "root",
        "ecsPort": 22,
        "sshKey": "",
        "deployDir": "/opt/touhou-trpg",
        "composeFile": "docker-compose.prod.yml",
        "n8nContainer": "touhou-trpg-n8n",
        "workspace": "",
        "ghRepo": "",
        "maxOutput": 30000
      },
      "tools": [
        "ecs_exec",
        "ecs_status",
        "ecs_upload",
        "n8n_status",
        "n8n_deploy_workflow",
        "gh_run_list",
        "gh_run_view"
      ],
      "commands": [],
      "test": null
    }
  ]
}
